{
  "description": "Harness hooks - Stop hook drives workflow next actions and PreToolUse protects runtime facts.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEAGENT3_PLUGIN_ROOT}/hooks/harness-guard.js\" --hook pre-tool-use --plugin-root \"${CODEAGENT3_PLUGIN_ROOT}\" --project-root . --session-id \"${CODEAGENT3_SESSION_ID}\" --engine-npx @codeagent3-temp/harness-engine@0.2.x --registry https://cmc.centralrepo.rnd.huawei.com/artifactory/api/npm/product_npm/ --ssl-flag 1",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEAGENT3_PLUGIN_ROOT}/hooks/harness-guard.js\" --hook stop --plugin-root \"${CODEAGENT3_PLUGIN_ROOT}\" --project-root . --session-id \"${CODEAGENT3_SESSION_ID}\" --engine-npx @codeagent3-temp/harness-engine@0.2.x --registry https://cmc.centralrepo.rnd.huawei.com/artifactory/api/npm/product_npm/ --ssl-flag 1",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
