{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hm2b.runner/schema/state.schema.json",
  "title": "hm2b.state/v1",
  "description": "Derived run state (`.hm2b/runs/<runId>/state.json`). runtime/runner/engine/src/state.js replays events.jsonl into this exact closed shape; a runner refuses a state whose schema revision is newer than hm2b.state/v1 (STATE_SCHEMA_NEWER, exit 2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "session_id",
    "status",
    "workflow_id",
    "workflow_engine",
    "engine",
    "engine_version",
    "interaction_mode",
    "started_at",
    "updated_at",
    "completed_at",
    "user_input",
    "current_step_id",
    "stages",
    "steps"
  ],
  "properties": {
    "schema": { "const": "hm2b.state/v1" },
    "run_id": {
      "type": "string",
      "pattern": "^R[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$",
      "description": "R<UTC timestamp>-<6 hex>; lexicographic order equals time order."
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "Real agent session id, or the synthetic cli-<runId> until a hook stop claims the run."
    },
    "status": {
      "enum": ["pending", "running", "paused", "completed", "failed", "cancelled"]
    },
    "workflow_id": { "type": "string", "minLength": 1 },
    "workflow_engine": {
      "type": ["string", "null"],
      "description": "Adapter/plugin name when a multi-workflow route selected this run; null otherwise."
    },
    "engine": { "type": "string", "minLength": 1 },
    "engine_version": { "type": "string", "minLength": 1 },
    "interaction_mode": { "enum": ["cli"] },
    "started_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "user_input": { "type": ["string", "null"] },
    "current_step_id": { "type": ["string", "null"] },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "started_at", "completed_at", "trace_started_at", "trace_completed_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "active", "completed"] },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "trace_started_at": { "type": ["string", "null"], "format": "date-time" },
        "trace_completed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "stage_id", "skill", "status", "retry_count", "review_retry_count"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "stage_id": { "type": "string", "minLength": 1 },
        "skill": { "type": ["string", "null"] },
        "status": { "enum": ["pending", "active", "completed", "failed", "skipped"] },
        "retry_count": { "type": "integer", "minimum": 0 },
        "review_retry_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
