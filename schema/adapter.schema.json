{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r2c.runner/schema/adapter.schema.json",
  "title": "r2c.adapter/v1",
  "description": "Agent adapter declaration (`adapters/<agent>/adapter.json`). The installer reads it, `adapter list` and docs/compat.md render from it; a different schema is ADAPTER_SCHEMA_UNSUPPORTED (exit 2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "requires",
    "detect",
    "scopes",
    "defaults",
    "hooks",
    "capabilities",
    "sharedRoots",
    "options",
    "manualSteps"
  ],
  "properties": {
    "schema": { "const": "r2c.adapter/v1" },
    "id": {
      "enum": ["claude-code", "codex", "dsh", "omp", "opencode"]
    },
    "title": { "type": "string", "minLength": 1 },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "agent"],
      "properties": {
        "engine": { "type": "string", "minLength": 1, "description": "Engine range; must equal r2c-plugin.json.engine byte for byte." },
        "agent": { "type": "string", "minLength": 1, "description": "Agent CLI range; a mismatch warns at runtime." }
      }
    },
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "paths"],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "description": "[command, ...args] probes; the first success decides detection."
        },
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Config roots; $VAR and ~ are expanded."
        },
        "envBins": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "globBins": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "versionArgs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["project", "user"] }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["copy", "link"] },
      "description": "Optional mode allow-list; absent means copy only except where defaults.mode says otherwise."
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "mode"],
      "properties": {
        "scope": { "enum": ["project", "user"] },
        "mode": { "enum": ["copy", "link"] }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop", "preToolUse", "usage"],
      "properties": {
        "stop": { "$ref": "#/$defs/hook" },
        "preToolUse": { "$ref": "#/$defs/hook" },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {
            "source": { "enum": ["transcript", "none"] }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop", "preToolUse", "commands", "skills", "agents", "mcp"],
      "properties": {
        "stop": { "enum": ["block", "idle"] },
        "preToolUse": { "enum": ["block", "throw"] },
        "commands": { "enum": ["md", "cordis", "wrap-skill"] },
        "skills": { "enum": ["md", "bundled"] },
        "agents": { "enum": ["none", "md", "toml"] },
        "mcp": { "enum": ["json", "none", "patch"] }
      }
    },
    "sharedRoots": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "options": {
      "type": "object",
      "description": "Adapter-specific options; the installer passes them through unchanged.",
      "additionalProperties": false,
      "properties": {
        "warnVersionPrefix": { "type": "string" },
        "warnVersionDetail": { "type": "string" },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "default", "description"],
          "properties": {
            "type": { "enum": ["string"] },
            "default": { "type": "string" },
            "description": { "type": "string" }
          }
        }
      }
    },
    "manualSteps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["carrier", "format"],
      "properties": {
        "carrier": {
          "type": ["string", "null"],
          "description": "Project-relative carrier file; null when the agent uses a native seam instead."
        },
        "format": { "enum": ["json", "plain"] },
        "native": { "type": "string", "minLength": 1 }
      }
    }
  }
}
