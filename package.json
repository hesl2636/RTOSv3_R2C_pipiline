{
  "name": "r2c-runner",
  "version": "0.1.0",
  "description": "Declarative workflow runner for the hm2B driver port pipeline",
  "license": "MIT",
  "type": "module",
  "bin": {
    "r2c": "bin/r2c.js"
  },
  "engines": {
    "node": ">=22.19.0 <23 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=8 test/*.test.js",
    "bundle:build": "node scripts/build-bundle.mjs examples/rtosv3/bundle",
    "bundle:check": "node scripts/build-bundle.mjs examples/rtosv3/bundle --check",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "yaml": "^2.4.0"
  }
}
