{
  "name": "r2c-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Bundle assembler, projections and installer for the r2c workflow runtime",
  "license": "MIT",
  "type": "module",
  "bin": {
    "r2c": "runtime/r2c/engine/bin/r2c.js",
    "r2c-assembler": "bin/r2c-assembler.js"
  },
  "engines": {
    "node": ">=22.19.0 <23 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=8 test/*.test.js",
    "web": "node web/serve.mjs",
    "bundle:build": "node scripts/build-bundle.mjs examples/rtosv3/bundle",
    "bundle:check": "node scripts/build-bundle.mjs examples/rtosv3/bundle --check",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "yaml": "^2.4.0"
  }
}
