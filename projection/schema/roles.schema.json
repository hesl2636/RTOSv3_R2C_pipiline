{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hm2b.runner/schema/projection-roles/v1",
  "title": "hm2b.projection.roles/v1",
  "description": "Per-target role report (roles.json) sectioned by target. Documentation only: runtime/shared/render-role.js produces the field states and installer/runner.js / runtime/agent-native/projection/project.js write the file.",
  "$comment": "Rules the producers enforce and this document does not express: targets and roles are sorted by id; roles covers every compiled workflow role including exposure skipped (artifact null); fields holds exactly the fields the compiled workflow set plus id, in ROLE_FIELD_ORDER; a degraded or unavailable field must have a matching entry in result.degradations; roles[].name equals metadata.idMap[target].roles[id]; placeholder equals the compiled workflow boolean; the file is canonical JSON (two-space indent, trailing LF) with no timestamps, host names or versions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "compiledWorkflow",
    "targets"
  ],
  "properties": {
    "schema": {
      "const": "hm2b.projection.roles/v1"
    },
    "compiledWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/targetEntry"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "targetEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "roles",
        "summary"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/id",
          "description": "Prefix applied to rendered role names: runner for the runner projection, the bundle id for agent-native."
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roleEntry"
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "roles",
            "native",
            "adapted",
            "degraded",
            "unavailable"
          ],
          "properties": {
            "roles": {
              "type": "integer",
              "minimum": 0
            },
            "native": {
              "type": "integer",
              "minimum": 0
            },
            "adapted": {
              "type": "integer",
              "minimum": 0
            },
            "degraded": {
              "type": "integer",
              "minimum": 0
            },
            "unavailable": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "roleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "placeholder",
        "exposure",
        "artifact",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Runtime-visible name: namespace plus the bare id."
        },
        "placeholder": {
          "type": "boolean"
        },
        "exposure": {
          "enum": [
            "subagent",
            "both",
            "primary",
            "skipped"
          ]
        },
        "artifact": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/artifact"
            }
          ]
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "id",
              "description",
              "instructions",
              "mode",
              "model",
              "effort",
              "tools",
              "tools_deny",
              "skills",
              "title",
              "placeholder"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/fieldState"
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "md",
            "toml"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fieldState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "native",
            "adapted",
            "degraded",
            "unavailable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
