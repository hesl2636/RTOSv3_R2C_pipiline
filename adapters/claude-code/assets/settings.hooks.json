{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PAYLOAD_HOME}/shims/hook.mjs\" --agent ${AGENT_ID} --event stop --format json --runner-cmd \"${RUNNER_CMD}\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PAYLOAD_HOME}/shims/hook.mjs\" --agent ${AGENT_ID} --event pre-tool-use --format json --runner-cmd \"${RUNNER_CMD}\""
          }
        ]
      }
    ]
  }
}
