{
  "schema": "r2c.adapter/v1",
  "id": "opencode",
  "title": "opencode (V1)",
  "requires": {
    "engine": "^0.1.0",
    "agent": ">=1.19.5 <2"
  },
  "detect": {
    "commands": [
      ["opencode", "--version"]
    ],
    "paths": [
      "~/.config/opencode"
    ]
  },
  "scopes": ["project", "user"],
  "defaults": {
    "scope": "project",
    "mode": "copy"
  },
  "hooks": {
    "stop": {
      "carrier": ".opencode/plugins/r2c.ts",
      "format": "plain"
    },
    "preToolUse": {
      "carrier": ".opencode/plugins/r2c.ts"
    },
    "usage": {
      "source": "none"
    }
  },
  "capabilities": {
    "stop": "idle",
    "preToolUse": "throw",
    "commands": "md",
    "skills": "md",
    "agents": "md",
    "mcp": "json"
  },
  "sharedRoots": [
    ".opencode/commands",
    ".opencode/skills"
  ],
  "options": {},
  "manualSteps": [
    "opencode V1 only: >=1.19.5 <2. If the plugin directory is not loaded (V1 plugin absent or version outside the pin), the install falls back to B mode: run \"r2c next --format plain\" or /r2c-next manually."
  ]
}
