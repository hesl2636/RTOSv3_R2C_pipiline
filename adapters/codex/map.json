{
  "schema": "r2c.adapter-map/v1",
  "entries": [
    {
      "from": "commands/r2c-*.md",
      "to": "{project}/.agents/skills/{stem}/SKILL.md",
      "action": "wrap-skill",
      "scope": "project"
    },
    {
      "from": "skills/*/SKILL.md",
      "to": "{project}/.agents/skills/{dir}/SKILL.md",
      "action": "copy",
      "scope": "project"
    },
    {
      "from": "assets/agent.toml.tpl",
      "to": "{project}/.codex/agents/r2c-{name}.toml",
      "action": "derive-agent",
      "enabledBy": "capabilities.agents",
      "scope": "project"
    },
    {
      "from": "adapters/codex/assets/hooks.json",
      "to": "{project}/.codex/hooks.json",
      "action": "render",
      "scope": "project"
    },
    {
      "from": "adapters/codex/assets/r2c-hook-stop.cmd",
      "to": "{project}/.codex/r2c-hook-stop.cmd",
      "action": "render",
      "scope": "project"
    },
    {
      "from": "adapters/codex/assets/r2c-hook-pre-tool-use.cmd",
      "to": "{project}/.codex/r2c-hook-pre-tool-use.cmd",
      "action": "render",
      "scope": "project"
    }
  ]
}
