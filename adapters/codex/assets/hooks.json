{
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node '${PAYLOAD_HOME}/shims/hook.mjs' --agent codex --event stop --format json --project-root '${PROJECT_ROOT}' --runner-cmd '${RUNNER_CMD}'",
            "commandWindows": "${PROJECT_ROOT}\\.codex\\r2c-hook-stop.cmd",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node '${PAYLOAD_HOME}/shims/hook.mjs' --agent codex --event pre-tool-use --format json --project-root '${PROJECT_ROOT}' --runner-cmd '${RUNNER_CMD}'",
            "commandWindows": "${PROJECT_ROOT}\\.codex\\r2c-hook-pre-tool-use.cmd",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
