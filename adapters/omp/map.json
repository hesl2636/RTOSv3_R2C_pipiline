{
  "schema": "r2c.adapter-map/v1",
  "entries": [
    {
      "from": "commands/r2c-*.md",
      "to": "{project}/.omp/commands/{stem}.md",
      "action": "render",
      "scope": "project"
    },
    {
      "from": "commands/r2c-*.md",
      "to": "{user}/.omp/agent/commands/{stem}.md",
      "action": "render",
      "scope": "user"
    },
    {
      "from": "skills/*/SKILL.md",
      "to": "{project}/.omp/skills/{dir}/SKILL.md",
      "action": "copy",
      "scope": "project"
    },
    {
      "from": "skills/*/SKILL.md",
      "to": "{user}/.omp/agent/skills/{dir}/SKILL.md",
      "action": "copy",
      "scope": "user"
    },
    {
      "from": "assets/agent.md",
      "to": "{project}/.omp/agents/r2c-{name}.md",
      "action": "derive-agent",
      "scope": "project"
    },
    {
      "from": "assets/agent.md",
      "to": "{user}/.omp/agent/agents/r2c-{name}.md",
      "action": "derive-agent",
      "scope": "user"
    },
    {
      "from": "adapters/omp/assets/hooks/post/r2c-stop.ts",
      "to": "{project}/.omp/hooks/post/r2c-stop.ts",
      "action": "render",
      "scope": "project"
    },
    {
      "from": "adapters/omp/assets/hooks/post/r2c-stop.ts",
      "to": "{user}/.omp/agent/hooks/post/r2c-stop.ts",
      "action": "render",
      "scope": "user"
    },
    {
      "from": "adapters/omp/assets/hooks/pre/r2c-guard.ts",
      "to": "{project}/.omp/hooks/pre/r2c-guard.ts",
      "action": "render",
      "scope": "project"
    },
    {
      "from": "adapters/omp/assets/hooks/pre/r2c-guard.ts",
      "to": "{user}/.omp/agent/hooks/pre/r2c-guard.ts",
      "action": "render",
      "scope": "user"
    },
    {
      "from": "assets/mcp.json",
      "to": "{project}/.omp/mcp.json",
      "action": "merge-json",
      "pointers": [
        "mcpServers"
      ],
      "scope": "project"
    },
    {
      "from": "assets/mcp.json",
      "to": "{user}/.omp/agent/mcp.json",
      "action": "merge-json",
      "pointers": [
        "mcpServers"
      ],
      "scope": "user"
    },
    {
      "from": "--mcp",
      "to": "{project}/.omp/mcp.json",
      "action": "merge-json",
      "pointers": [
        "mcpServers"
      ],
      "scope": "project",
      "optional": "mcp"
    },
    {
      "from": "--mcp",
      "to": "{user}/.omp/agent/mcp.json",
      "action": "merge-json",
      "pointers": [
        "mcpServers"
      ],
      "scope": "user",
      "optional": "mcp"
    }
  ]
}
